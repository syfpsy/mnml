.vercel

# The installer + auto-updater manifest are built locally and uploaded to
# Vercel via `vercel --prod`. The .exe is ~80 MB (too large for git); the
# .yml and .blockmap are deploy-only artefacts that pair with each .exe.
# All three are regenerated by `npm run build`.
site/mnml-setup.exe
site/mnml-setup.exe.blockmap
site/latest.yml
site/mnml-mac.zip
site/mnml-mac.dmg
site/latest-mac.yml

# Local signing credentials (Mac mini)
.env.release

# TypeScript incremental build info
*.tsbuildinfo

# Intermediate file the icon-generation script (`npm run icons`) writes
# before renaming each rasterised size to `icon-NN.png`. If the script is
# interrupted mid-run, it leaves a stray `icon.png` behind — don't commit it.
build/icon.png

# Local AI / agent tooling — not part of the product. Stays on disk, kept
# out of the (now public) repo so we don't ship personal config or
# third-party skill content.
.claude/
.agents/
skills-lock.json

.vercel
