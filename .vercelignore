.claude
.vite
.vercel
.git
*.log
*.tsbuildinfo
package-lock.json
# Anchor with leading `/` so we only match the repo-root files, not the
# same-named ones inside `site/` (which is what we actually want to ship).
/index.html
tsconfig*.json
vite.config.ts
/ARCHITECTURE.md
/CHANGELOG.md
/README.md
/LICENSE
