{
  "name": "mnml",
  "version": "0.3.10",
  "description": "mnml — a super minimal clipboard manager for Windows and macOS",
  "private": true,
  "main": "dist-electron/main.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/syfpsy/mnml"
  },
  "scripts": {
    "dev": "vite",
    "check:summon": "node scripts/check-window-summon-rules.mjs",
    "check:site-headers": "node scripts/check-site-security-headers.mjs",
    "icons": "node scripts/make-icons.mjs",
    "verify:mac-icon": "node scripts/verify-mac-icon.mjs",
    "build": "npm run check:summon && node scripts/bump-version.mjs && npm run rebuild && node scripts/verify-native-bindings.mjs && tsc -b && vite build && electron-builder",
    "build:dir": "npm run check:summon && node scripts/bump-version.mjs && npm run rebuild && node scripts/verify-native-bindings.mjs && tsc -b && vite build && electron-builder --dir",
    "build:release": "npm run check:summon && npm run rebuild && node scripts/verify-native-bindings.mjs && tsc -b && vite build && electron-builder",
    "build:release:win": "npm run check:summon && npm run rebuild && node scripts/verify-native-bindings.mjs && tsc -b && vite build && electron-builder --win",
    "build:release:mac": "npm run check:summon && npm run verify:mac-icon && npm run rebuild && node scripts/verify-native-bindings.mjs && tsc -b && vite build && electron-builder --mac --arm64",
    "release:notes": "node scripts/extract-changelog.mjs",
    "verify:release": "node scripts/verify-release-artifacts.mjs",
    "release": "npm run check:summon && node scripts/bump-version.mjs && npm run rebuild && node scripts/verify-native-bindings.mjs && tsc -b && vite build && electron-builder --publish always",
    "postinstall": "node scripts/rebuild-native.mjs",
    "rebuild": "node scripts/rebuild-native.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "electron-updater": "^6.8.3",
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@electron/notarize": "^2.5.0",
    "@tailwindcss/vite": "^4.2.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "dev.mnml.app",
    "productName": "mnml",
    "copyright": "Copyright © 2026 mnml",
    "publish": {
      "provider": "generic",
      "url": "https://mnml.nxyz.art/",
      "channel": "latest",
      "useMultipleRangeRequest": false
    },
    "directories": {
      "output": "release"
    },
    "asar": false,
    "npmRebuild": false,
    "afterPack": "./scripts/copy-native-deps.mjs",
    "afterSign": "scripts/notarize-mac.cjs",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build",
        "to": "build",
        "filter": [
          "tray.png",
          "icon.ico",
          "icon-512.png"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "mnml-setup.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "mnml",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    },
    "mac": {
      "icon": "build/icon-512.png",
      "category": "public.app-category.productivity",
      "artifactName": "mnml-mac.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        { "target": "dmg", "arch": ["arm64"] },
        { "target": "zip", "arch": ["arm64"] }
      ]
    },
    "dmg": {
      "title": "mnml"
    }
  }
}
