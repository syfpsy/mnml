{
  "name": "mnml",
  "version": "0.2.42",
  "description": "mnml — a super minimal clipboard manager for Windows",
  "private": true,
  "main": "dist-electron/main.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/syfpsy/mnml"
  },
  "scripts": {
    "dev": "vite",
    "check:summon": "node scripts/check-window-summon-rules.mjs",
    "icons": "node scripts/make-icons.mjs",
    "build": "npm run check:summon && node scripts/bump-version.mjs && tsc -b && vite build && electron-builder",
    "build:dir": "npm run check:summon && node scripts/bump-version.mjs && tsc -b && vite build && electron-builder --dir",
    "release": "npm run check:summon && node scripts/bump-version.mjs && tsc -b && vite build && electron-builder --publish always",
    "postinstall": "electron-rebuild -f -o better-sqlite3",
    "rebuild": "electron-rebuild -f -o better-sqlite3"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "electron-updater": "^6.8.3",
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@tailwindcss/vite": "^4.2.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "dev.mnml.app",
    "productName": "mnml",
    "copyright": "Copyright © 2026 mnml",
    "publish": {
      "provider": "generic",
      "url": "https://mnml.nxyz.art/",
      "channel": "latest",
      "useMultipleRangeRequest": false
    },
    "directories": {
      "output": "release"
    },
    "asar": false,
    "npmRebuild": false,
    "afterPack": "./scripts/copy-native-deps.mjs",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build",
        "to": "build",
        "filter": [
          "tray.png",
          "icon.ico"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "mnml-setup.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "mnml",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    }
  }
}
