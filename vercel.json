{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "echo skip",
  "installCommand": "echo skip",
  "outputDirectory": "site",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",     "value": "interest-cohort=()" },
        { "key": "X-Frame-Options",        "value": "DENY" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/(.*)\\.(svg|png|webp|jpg|jpeg|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/mnml-setup.exe",
      "destination": "https://github.com/syfpsy/mnml/releases/latest/download/mnml-setup.exe",
      "permanent": false
    },
    {
      "source": "/latest.yml",
      "destination": "https://github.com/syfpsy/mnml/releases/latest/download/latest.yml",
      "permanent": false
    },
    {
      "source": "/mnml-setup.exe.blockmap",
      "destination": "https://github.com/syfpsy/mnml/releases/latest/download/mnml-setup.exe.blockmap",
      "permanent": false
    },
    {
      "source": "/mnml-mac.zip",
      "destination": "https://github.com/syfpsy/mnml/releases/latest/download/mnml-mac.zip",
      "permanent": false
    },
    {
      "source": "/mnml-mac.dmg",
      "destination": "https://github.com/syfpsy/mnml/releases/latest/download/mnml-mac.dmg",
      "permanent": false
    },
    {
      "source": "/latest-mac.yml",
      "destination": "https://github.com/syfpsy/mnml/releases/latest/download/latest-mac.yml",
      "permanent": false
    },
    {
      "source": "/mnml-mac.zip.blockmap",
      "destination": "https://github.com/syfpsy/mnml/releases/latest/download/mnml-mac.zip.blockmap",
      "permanent": false
    }
  ]
}
